# Backend Environment Variables
PROJECT_NAME="Smart Job Application Tracker & Resume Analyzer"
SECRET_KEY="your-super-secret-jwt-key-here-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL or SQLite)
# Example for PostgreSQL: postgresql://postgres:password@localhost:5432/jobtracker
# Example for SQLite: sqlite:///./jobtracker.db
DATABASE_URL="sqlite:///./jobtracker.db"

# CORS configuration (JSON array or comma-separated URLs in production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
